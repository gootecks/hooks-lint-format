amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Builtins.pkl" as KitBuiltins

exclude = List(
    ".omp/**",
    ".agents/**",
    ".obsidian/**",
    "dist/**",
    "CHANGELOG.md"
)

steps {
    ["actionlint"] = KitBuiltins.actionlint
    ["oxfmt"] = KitBuiltins.oxfmt
    ["oxlint"] = (KitBuiltins.ox_lint) {
        check = "oxlint --type-aware --type-check --deny-warnings {{files}}"
        fix = "oxlint --type-aware --type-check --deny-warnings --fix {{files}}"
    }
    ["rumdl"] {
        glob = List("**/*.md", "**/*.markdown", "**/*.mdx")
        check = "rumdl check --deny-config-warnings {{files}} && hlf-rumdl-docs-check {{files}}"
        fix = "hlf-rumdl-fix {{files}}"
    }
    ["zizmor"] = KitBuiltins.zizmor
}

hooks {
    ["check"] {
        fix = false
        stage = false
        stash = "none"
    }
    ["fix"] {
        fix = true
        stage = false
        stash = "none"
    }
    ["pre-commit"] {
        fix = true
        stage = true
        stash = "git"
    }
    ["commit-msg"] {
        steps {
            ["conventional-commit"] = KitBuiltins.check_conventional_commit
        }
    }
}
